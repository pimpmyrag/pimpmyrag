{"id": "story_food_objects_0012", "text": "Pendant une heure, le parfum envahit la pièce et la porte métallique claque.", "spans": [{"start": 0, "end": 17, "label": "hint_time_duration", "text": "Pendant une heure"}, {"start": 52, "end": 68, "label": "hint_infra", "text": "porte métallique"}], "meta": {"lang": "fr", "source": "synthetic_story", "offsets": "0-based, end exclusive"}}
{"id": "story_food_objects_0013", "text": "Son voisin Julien Morel passe avec une caisse à outils et une perceuse.", "spans": [{"start": 4, "end": 10, "label": "hint_group_role", "text": "voisin"}, {"start": 11, "end": 23, "label": "hint_person_name", "text": "Julien Morel"}, {"start": 39, "end": 54, "label": "hint_object_generic", "text": "caisse à outils"}, {"start": 62, "end": 70, "label": "hint_tool", "text": "perceuse"}], "meta": {"lang": "fr", "source": "synthetic_story", "offsets": "0-based, end exclusive"}}
{"id": "story_food_objects_0014", "text": "Il propose de réparer l’étagère bancale avec 12 vis et 3 chevilles.", "spans": [{"start": 14, "end": 21, "label": "hint_event_nominal", "text": "réparer"}, {"start": 24, "end": 31, "label": "hint_infra", "text": "étagère"}, {"start": 45, "end": 51, "label": "hint_count", "text": "12 vis"}, {"start": 55, "end": 66, "label": "hint_count", "text": "3 chevilles"}], "meta": {"lang": "fr", "source": "synthetic_story", "offsets": "0-based, end exclusive"}}
