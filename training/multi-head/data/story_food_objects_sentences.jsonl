{"id": "story_food_objects_0001", "text": "À l’aube, Camille ouvre la porte de l’atelier et pose un panier de pommes sur l’étagère.", "spans": [{"start": 10, "end": 17, "label": "hint_person_name", "text": "Camille"}, {"start": 38, "end": 45, "label": "hint_fac_name", "text": "atelier"}, {"start": 57, "end": 63, "label": "hint_object_generic", "text": "panier"}, {"start": 67, "end": 73, "label": "hint_food", "text": "pommes"}, {"start": 80, "end": 87, "label": "hint_infra", "text": "étagère"}], "meta": {"lang": "fr", "source": "synthetic_story", "offsets": "0-based, end exclusive"}}
{"id": "story_food_objects_0002", "text": "Sur la table, elle aligne un couteau, une spatule et un bocal de miel.", "spans": [{"start": 29, "end": 36, "label": "hint_tool", "text": "couteau"}, {"start": 42, "end": 49, "label": "hint_tool", "text": "spatule"}, {"start": 56, "end": 61, "label": "hint_object_generic", "text": "bocal"}, {"start": 65, "end": 69, "label": "hint_food", "text": "miel"}], "meta": {"lang": "fr", "source": "synthetic_story", "offsets": "0-based, end exclusive"}}
