{
  "_comment": "Config role-head — réactivation ancienne tête role (12 labels SUBJECT/OBJECT/OBLIQUE_*/APPOS)",
  "_version": "role-head",
  "_rationale": [
    "Diagnostic svo-flat a prouvé que role_coarse ne converge jamais (OBJ=0, collapse APPOS).",
    "Raison : OBLIQ = méga-classe hétérogène + role_oblique amplifie OBLIQ x2 vs SUBJ/OBJ.",
    "Solution : réactiver l'ancienne role_head (12 labels) qui marchait en v8.0/v8.1 (SVO=0.826).",
    "  - lambda_role = 0.4 (entre 0.35 et 0.6 historique)",
    "  - lambda_role_coarse = 0.0, lambda_role_oblique = 0.0 (désactivées)",
    "  - Même régime que svo-flat : no curriculum, full data ep1, no warmup",
    "  - NER actif (coarse+fine+morpho=1.0) pour enrichir span_h"
  ],

  "run": {
    "name_suffix": "role-head",
    "max_epochs": 60,
    "model": "microsoft/deberta-v3-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },

  "optimizer": {
    "lr": 1e-5,
    "head_lr_multiplier": 6.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 1.0
  },

  "lambdas": {
    "_comment": "role_head (12 labels) réactivé à 0.4. role_coarse + role_oblique désactivés (cause du collapse).",
    "boundary":     1.0,
    "coarse":       1.0,
    "fine":         1.0,
    "svo_boundary": 1.0,
    "svo":          1.0,
    "role_coarse":  0.0,
    "semantic_role": 0.0,
    "role":         0.4,
    "voice":        1.0,
    "certainty":    1.0,
    "morpho":       1.0,
    "verb_ptr":     0.0,
    "compat":       0.0
  },

  "focal": {
    "boundary_gamma":  0.0,
    "fine_gamma":      0.0,
    "coarse_gamma":    0.0
  },

  "boundary_first": {
    "enabled": false,
    "unlock_threshold":    0.0,
    "unlock_ramp_epochs":  1,
    "coarse_warmup_lambda": 0.0,
    "fine_warmup_lambda":   0.0
  },

  "svo_cascade": {
    "_comment": "Aucune condition — tout actif dès ep1",
    "role_coarse_bnd_thr":       0.0,
    "role_coarse_warmup_lambda": 0.0,
    "role_ramp_epochs":          1,
    "role_thr_svo_bnd":          0.0,
    "phase2_ramp_epochs":        1,
    "oblique_thr_role_crs":      0.0,
    "oblique_ramp_epochs":       1
  },

  "boundary_rescue": {
    "window": 999, "target": 0.0, "min_delta": 0.0,
    "factor_vptr_voice": 1.0, "factor_coarse": 1.0, "bnd_boost": 1.0
  },

  "boundary_plateau": {
    "window": 999, "min_delta": 0.0,
    "regression_window": 999, "regression_delta": 0.0
  },

  "hard_negatives": {
    "every_n_epochs": 999,
    "decay":          1.0,
    "max_weight":     1.0,
    "min_weight":     1.0,
    "boost_fp":       1.0,
    "boost_fn":       1.0,
    "boost_coarse":   1.0,
    "boost_fine":     1.0,
    "boost_fp_svo":   1.0,
    "boost_fn_svo":   1.0,
    "boost_role_coarse": 1.0
  },

  "difficulty_levels": {
    "_comment": "Full data dès ep1 — pas de curriculum",
    "names":         ["full"],
    "hard_per_gold": [6],
    "soft_factors":  [1.0],
    "max_epochs_per_level":   999,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },

  "early_stopping": {
    "patience": 0,
    "min_delta": 0.0
  },

  "hardware": {
    "h100_80gb":  {"bs": 160, "accum": 1, "workers": 12},
    "l40s_48gb":  {"bs": 128, "accum": 1, "workers": 12},
    "a100_40gb":  {"bs":  96, "accum": 1, "workers": 10},
    "rtx_4090":   {"bs":  80, "accum": 1, "workers": 10},
    "rtx_3090":   {"bs":  64, "accum": 1, "workers": 4},
    "default":    {"bs":  16, "accum": 2, "workers": 0}
  }
}

