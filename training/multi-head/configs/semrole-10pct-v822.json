{
  "_comment": "Config validation 10% dataset v8.22_semrole — run court RunPod pour valider semantic_role_head avant full training. Val/Test = complets pour métriques comparables prod.",
  "_version": "semrole-10pct-v822",
  "_changelog": [
    "Base : svo-v819-rc2.json (même cascade, même lambdas)",
    "Différences vs prod :",
    "  - dataset : v8.22_semrole_10pct (2783 train, val/test complets)",
    "  - max_epochs : 25 (convergence attendue ~12-15 ep sur 10%)",
    "  - semantic_role : 0.3 (vs 0.2 rc2 — nouvelle valeur cible semantic_role_head)",
    "  - difficulty_levels : curriculum raccourci (max 3 ep/level vs 6)",
    "  - Objectif : vérifier que semantic_role_head apprend sans dégrader bnd/fine"
  ],

  "run": {
    "name_suffix": "semrole-10pct-v822",
    "max_epochs": 25,
    "model": "microsoft/deberta-v3-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },

  "optimizer": {
    "lr": 8e-6,
    "head_lr_multiplier": 4.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.999,
    "class_weight_power": 0.5
  },

  "lambdas": {
    "_comment": "Identique svo-v819-rc2 sauf semantic_role=0.3 (nouvelle cible).",
    "boundary":         4.0,
    "coarse":           0.75,
    "fine":             1.8,
    "svo_boundary":     0.55,
    "svo":              0.70,
    "role_coarse":      0.55,
    "semantic_role":    0.30,
    "voice":            0.15,
    "certainty":        0.30,
    "morpho":           0.10,
    "verb_ptr":         0.60,
    "compat":           0.20,
    "verb_family":      0.80,
    "verb_family_fine": 0.40,
    "verb_polarity":    0.40,
    "verb_aspect":      0.40,
    "verb_source":      0.30
  },

  "focal": {
    "boundary_gamma":  0.5,
    "fine_gamma":      1.5,
    "coarse_gamma":    0.0
  },

  "boundary_first": {
    "enabled": true,
    "unlock_threshold":    0.92,
    "unlock_ramp_epochs":  5,
    "coarse_warmup_lambda": 0.05,
    "fine_warmup_lambda":   0.15
  },

  "svo_cascade": {
    "_comment": "Identique svo-v819-rc2.",
    "role_coarse_bnd_thr":       0.9,
    "role_coarse_warmup_lambda": 0.55,
    "role_ramp_epochs":          1,
    "role_thr_svo_bnd":          0.80,
    "phase2_ramp_epochs":        2,
    "oblique_thr_role_crs":      0.40,
    "oblique_ramp_epochs":       5
  },

  "boundary_rescue": {
    "window":            4,
    "target":            0.90,
    "min_delta":         0.003,
    "factor_vptr_voice": 0.65,
    "factor_coarse":     0.75,
    "bnd_boost":         1.20
  },

  "boundary_plateau": {
    "window":            4,
    "min_delta":         0.003,
    "regression_window": 2,
    "regression_delta":  0.008
  },

  "hard_negatives": {
    "every_n_epochs": 1,
    "decay":          0.85,
    "max_weight":     8.0,
    "min_weight":     0.3,
    "boost_fp":       5.0,
    "boost_fn":       2.0,
    "boost_coarse":   2.5,
    "boost_fine":     3.0,
    "boost_fp_svo":   3.0,
    "boost_fn_svo":   2.0,
    "boost_role_coarse": 2.5
  },

  "difficulty_levels": {
    "_comment": "Curriculum raccourci : 3 ep max/level pour couvrir easy→full en ~15 ep.",
    "names":         ["easy", "medium", "hard", "full"],
    "hard_per_gold": [2,      3,        5,      6],
    "soft_factors":  [1.0,    1.5,      2.0,    2.0],
    "max_epochs_per_level":   3,
    "min_delta_for_progress": 0.0003,
    "patience": 4
  },

  "early_stopping": {
    "patience":   4,
    "min_delta":  0.0003
  },

  "hardware": {
    "_comment": "Même config RunPod que prod.",
    "h100_80gb":  {"bs": 160, "accum": 1, "workers": 8},
    "l40s_48gb":  {"bs": 128, "accum": 1, "workers": 6},
    "a100_40gb":  {"bs":  96, "accum": 1, "workers": 6},
    "rtx_4090":   {"bs":  80, "accum": 1, "workers": 8},
    "rtx_3090":   {"bs":  64, "accum": 1, "workers": 4},
    "default":    {"bs":  16, "accum": 2, "workers": 0}
  }
}

