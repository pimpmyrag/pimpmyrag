{
  "_comment": "Test rapide DeBERTa-v3-large — 7 epochs, NER boundary/fine only focus",
  "_version": "large-test-7ep",
  "run": {
    "name_suffix": "large-test-7ep",
    "max_epochs": 7,
    "model": "microsoft/deberta-v3-large",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },
  "optimizer": {
    "lr": 1e-05,
    "head_lr_multiplier": 6.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 1.0
  },
  "lambdas": {
    "boundary": 1.0,
    "coarse": 1.0,
    "fine": 1.0,
    "svo_boundary": 0.5,
    "svo": 1.0,
    "role_coarse": 0.0,
    "semantic_role": 1.0,
    "role": 1.0,
    "voice": 0.3,
    "certainty": 0.3,
    "morpho": 0.3,
    "verb_ptr": 0.5,
    "compat": 0.5,
    "verb_family": 0.8,
    "verb_family_fine": 0.4,
    "verb_polarity": 0.4,
    "verb_aspect": 0.4,
    "verb_source": 0.3
  },
  "focal": {
    "boundary_gamma": 0.0,
    "fine_gamma": 0.0,
    "coarse_gamma": 0.0
  },
  "boundary_first": {
    "enabled": false,
    "unlock_threshold": 0.0,
    "unlock_ramp_epochs": 1,
    "coarse_warmup_lambda": 0.0,
    "fine_warmup_lambda": 0.0
  },
  "svo_cascade": {
    "_comment": "Aucune condition — tout actif dès ep1",
    "role_coarse_bnd_thr": 0.0,
    "role_coarse_warmup_lambda": 0.0,
    "role_ramp_epochs": 1,
    "role_thr_svo_bnd": 0.0,
    "phase2_ramp_epochs": 1,
    "oblique_thr_role_crs": 0.0,
    "oblique_ramp_epochs": 1
  },
  "boundary_rescue": {
    "window": 999,
    "target": 0.0,
    "min_delta": 0.0,
    "factor_vptr_voice": 1.0,
    "factor_coarse": 1.0,
    "bnd_boost": 1.0
  },
  "boundary_plateau": {
    "window": 999,
    "min_delta": 0.0,
    "regression_window": 999,
    "regression_delta": 0.0
  },
  "hard_negatives": {
    "every_n_epochs": 999,
    "decay": 1.0,
    "max_weight": 1.0,
    "min_weight": 1.0,
    "boost_fp": 1.0,
    "boost_fn": 1.0,
    "boost_coarse": 1.0,
    "boost_fine": 1.0,
    "boost_fp_svo": 1.0,
    "boost_fn_svo": 1.0,
    "boost_role_coarse": 1.0
  },
  "difficulty_levels": {
    "_comment": "Full data dès ep1",
    "names": [
      "full"
    ],
    "hard_per_gold": [
      6
    ],
    "soft_factors": [
      1.0
    ],
    "max_epochs_per_level": 999,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },
  "early_stopping": {
    "patience": 0,
    "min_delta": 0.0
  },
  "hardware": {
    "h100_80gb": {
      "bs": 96,
      "accum": 1,
      "workers": 12
    },
    "l40s_48gb": {
      "bs": 48,
      "accum": 2,
      "workers": 12
    },
    "a40_48gb": {
      "bs": 48,
      "accum": 2,
      "workers": 12
    },
    "a100_40gb": {
      "bs": 48,
      "accum": 2,
      "workers": 10
    },
    "rtx_4090": {
      "bs": 32,
      "accum": 3,
      "workers": 8
    },
    "default": {
      "bs": 16,
      "accum": 4,
      "workers": 0
    }
  }
}