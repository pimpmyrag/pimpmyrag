{
  "_comment": "Config diagnostic SVO isolé — toutes gates ouvertes dès ep1, NER réduit au minimum",
  "_version": "svo-isolated",
  "_rationale": [
    "Objectif : diagnostiquer si role_coarse peut apprendre SUBJ/OBJ/OBLIQ/APPOS sans la complexité NER.",
    "Choix :",
    "  - boundary=1.0 minimal pour garder l'encoder ancré sur les spans",
    "  - coarse=0 fine=0 morpho=0 compat=0 : têtes NER classification désactivées",
    "  - svo_boundary+svo+role_coarse+verb_ptr forts dès ep1",
    "  - boundary_first désactivé",
    "  - Toutes gates SVO à seuil 0.0 → tout actif immédiatement",
    "  - Pas de curriculum, pas de hard_negatives, pas d'early_stopping",
    "  - 60 epochs, full data dès ep1"
  ],

  "run": {
    "name_suffix": "svo-isolated",
    "max_epochs": 60,
    "model": "microsoft/deberta-v3-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },

  "optimizer": {
    "lr": 1e-5,
    "head_lr_multiplier": 6.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 1.0
  },

  "lambdas": {
    "_comment": "NER minimal (boundary seul). SVO à fond dès ep1.",
    "boundary":     1.0,
    "coarse":       0.0,
    "fine":         0.0,
    "svo_boundary": 2.0,
    "svo":          2.5,
    "role_coarse":  2.0,
    "role_oblique": 1.0,
    "voice":        0.5,
    "certainty":    0.5,
    "morpho":       0.0,
    "verb_ptr":     2.0,
    "compat":       0.0
  },

  "focal": {
    "boundary_gamma":  0.0,
    "fine_gamma":      0.0,
    "coarse_gamma":    0.0
  },

  "boundary_first": {
    "enabled": false,
    "unlock_threshold":    0.0,
    "unlock_ramp_epochs":  1,
    "coarse_warmup_lambda": 0.0,
    "fine_warmup_lambda":   0.0
  },

  "svo_cascade": {
    "_comment": "Tout ouvert dès ep1 — on veut voir si role_coarse peut apprendre sans blocages",
    "role_coarse_bnd_thr":       0.0,
    "role_coarse_warmup_lambda": 2.0,
    "role_ramp_epochs":          1,
    "role_thr_svo_bnd":          0.0,
    "phase2_ramp_epochs":        1,
    "oblique_thr_role_crs":      0.0,
    "oblique_ramp_epochs":       1
  },

  "boundary_rescue": {
    "window": 999, "target": 0.0, "min_delta": 0.0,
    "factor_vptr_voice": 1.0, "factor_coarse": 1.0, "bnd_boost": 1.0
  },

  "boundary_plateau": {
    "window": 999, "min_delta": 0.0,
    "regression_window": 999, "regression_delta": 0.0
  },

  "hard_negatives": {
    "every_n_epochs": 999,
    "decay":          1.0,
    "max_weight":     1.0,
    "min_weight":     1.0,
    "boost_fp":       1.0,
    "boost_fn":       1.0,
    "boost_coarse":   1.0,
    "boost_fine":     1.0,
    "boost_fp_svo":   1.0,
    "boost_fn_svo":   1.0,
    "boost_role_coarse": 1.0
  },

  "difficulty_levels": {
    "_comment": "Full data dès ep1 — pas de curriculum progressif",
    "names":         ["full"],
    "hard_per_gold": [6],
    "soft_factors":  [1.0],
    "max_epochs_per_level":   999,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },

  "early_stopping": {
    "patience": 0,
    "min_delta": 0.0
  },

  "hardware": {
    "h100_80gb":  {"bs": 160, "accum": 1, "workers": 8},
    "l40s_48gb":  {"bs": 128, "accum": 1, "workers": 6},
    "a100_40gb":  {"bs":  96, "accum": 1, "workers": 6},
    "rtx_4090":   {"bs":  80, "accum": 1, "workers": 8},
    "rtx_3090":   {"bs":  64, "accum": 1, "workers": 4},
    "default":    {"bs":  16, "accum": 2, "workers": 0}
  }
}

