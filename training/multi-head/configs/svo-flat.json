{
  "_comment": "Config diagnostic SVO flat — lambda=1 partout, aucune condition de cascade, tout linéaire dès ep1",
  "_version": "svo-flat",
  "_rationale": [
    "Objectif : baseline complètement plate pour diagnostiquer role_coarse SUBJ/OBJ/OBLIQ/APPOS.",
    "Choix :",
    "  - Tous les lambdas actifs = 1.0 (pas de surpondération, signal égal pour tout le monde)",
    "  - coarse=fine=morpho=compat=0 : têtes NER classification désactivées",
    "  - Aucune condition de cascade (seuils=0, ramp=1 epoch) → tout actif dès ep1",
    "  - boundary_first désactivé",
    "  - Pas de curriculum, pas de hard_negatives, pas d'early_stopping",
    "  - 60 epochs, full data dès ep1"
  ],

  "run": {
    "name_suffix": "svo-flat",
    "max_epochs": 60,
    "model": "microsoft/deberta-v3-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },

  "optimizer": {
    "lr": 1e-5,
    "head_lr_multiplier": 6.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 1.0
  },

  "lambdas": {
    "_comment": "Tout à 1.0 — NER coarse+fine actifs, verb_ptr=0. Test si NER enrichit span_h pour role_coarse.",
    "boundary":     1.0,
    "coarse":       1.0,
    "fine":         1.0,
    "svo_boundary": 1.0,
    "svo":          1.0,
    "role_coarse":  1.0,
    "semantic_role": 1.0,
    "voice":        1.0,
    "certainty":    1.0,
    "morpho":       1.0,
    "verb_ptr":     0.0,
    "compat":       0.0
  },

  "focal": {
    "boundary_gamma":  0.0,
    "fine_gamma":      0.0,
    "coarse_gamma":    0.0
  },

  "boundary_first": {
    "enabled": false,
    "unlock_threshold":    0.0,
    "unlock_ramp_epochs":  1,
    "coarse_warmup_lambda": 0.0,
    "fine_warmup_lambda":   0.0
  },

  "svo_cascade": {
    "_comment": "Aucune condition — seuils=0, warmup_lambda=1.0, ramp=1 epoch → tout à plein régime dès ep1",
    "role_coarse_bnd_thr":       0.0,
    "role_coarse_warmup_lambda": 1.0,
    "role_ramp_epochs":          1,
    "role_thr_svo_bnd":          0.0,
    "phase2_ramp_epochs":        1,
    "oblique_thr_role_crs":      0.0,
    "oblique_ramp_epochs":       1
  },

  "boundary_rescue": {
    "window": 999, "target": 0.0, "min_delta": 0.0,
    "factor_vptr_voice": 1.0, "factor_coarse": 1.0, "bnd_boost": 1.0
  },

  "boundary_plateau": {
    "window": 999, "min_delta": 0.0,
    "regression_window": 999, "regression_delta": 0.0
  },

  "hard_negatives": {
    "every_n_epochs": 999,
    "decay":          1.0,
    "max_weight":     1.0,
    "min_weight":     1.0,
    "boost_fp":       1.0,
    "boost_fn":       1.0,
    "boost_coarse":   1.0,
    "boost_fine":     1.0,
    "boost_fp_svo":   1.0,
    "boost_fn_svo":   1.0,
    "boost_role_coarse": 1.0
  },

  "difficulty_levels": {
    "_comment": "Full data dès ep1 — pas de curriculum progressif",
    "names":         ["full"],
    "hard_per_gold": [6],
    "soft_factors":  [1.0],
    "max_epochs_per_level":   999,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },

  "early_stopping": {
    "patience": 0,
    "min_delta": 0.0
  },

  "hardware": {
    "h100_80gb":  {"bs": 160, "accum": 1, "workers": 12},
    "l40s_48gb":  {"bs": 128, "accum": 1, "workers": 12},
    "a100_40gb":  {"bs":  96, "accum": 1, "workers": 10},
    "rtx_4090":   {"bs":  80, "accum": 1, "workers": 10},
    "rtx_3090":   {"bs":  64, "accum": 1, "workers": 4},
    "default":    {"bs":  16, "accum": 2, "workers": 0}
  }
}

