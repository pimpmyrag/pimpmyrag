{
  "_comment": "Variante ModernBERT-base de bnd-fine-balanced-v824 — MÊME training, encodeur différent.",
  "_version": "bnd-fine-balanced-v824-modernbert",
  "_rationale": [
    "Identique à bnd-fine-balanced-v824.json SAUF run.model = answerdotai/ModernBERT-base.",
    "But : comparer ModernBERT-base vs DeBERTa-v3-base à taxo/λ/dataset identiques (v8.24b_deps, v9).",
    "ModernBERT : hidden_size=768 (== deberta-base) → têtes inchangées ; pas de token_type_ids.",
    "Requiert transformers>=4.48 (bumpé à 4.53.0 dans requirements.txt).",
    "torch.compile reste désactivé (non passé) ; attention SDPA par défaut sur torch 2.4."
  ],
  "run": {
    "name_suffix": "bnd-fine-balanced-v824-modernbert",
    "max_epochs": 30,
    "model": "answerdotai/ModernBERT-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },
  "optimizer": {
    "lr": 1e-5,
    "head_lr_multiplier": 4.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 0.5
  },
  "lambdas": {
    "boundary": 5,
    "coarse": 2,
    "fine": 2.5,
    "svo_boundary": 2,
    "svo": 0.70,
    "role": 0,
    "role_coarse": 0.8,
    "semantic_role": 0.8,
    "voice": 0.20,
    "certainty": 0.30,
    "morpho": 0.20,
    "verb_ptr": 0.80,
    "verb_family": 1.5,
    "verb_family_fine": 0.4,
    "verb_polarity": 1.0,
    "verb_aspect": 0.5,
    "verb_source": 0.4,
    "compat": 0.2,
    "attributes": 0.5
  },
  "focal": {
    "boundary_gamma": 0.5,
    "fine_gamma": 1.5,
    "coarse_gamma": 0.0
  },
  "boundary_first": {
    "_comment": "OFF (stratégie balanced) — unlock/ramp neutralisés.",
    "enabled": false,
    "unlock_threshold": 0.90,
    "unlock_ramp_epochs": 5,
    "coarse_warmup_lambda": 0.3,
    "fine_warmup_lambda": 0.3
  },
  "svo_cascade": {
    "role_coarse_bnd_thr": 0.0,
    "role_coarse_warmup_lambda": 0.3,
    "role_ramp_epochs": 1,
    "role_thr_svo_bnd": 0.0,
    "phase2_ramp_epochs": 1,
    "oblique_thr_role_crs": 0.0,
    "oblique_ramp_epochs": 1
  },
  "boundary_rescue": {
    "window": 999,
    "target": 0.0,
    "min_delta": 0.0,
    "factor_vptr_voice": 1.0,
    "factor_coarse": 1.0,
    "bnd_boost": 1.0
  },
  "boundary_plateau": {
    "window": 999,
    "min_delta": 0.0,
    "regression_window": 999,
    "regression_delta": 0.0
  },
  "hard_negatives": {
    "_comment": "Mining orienté précision boundary : boost FP > FN.",
    "every_n_epochs": 3,
    "decay": 1.0,
    "max_weight": 4.0,
    "min_weight": 1.0,
    "boost_fp": 2.0,
    "boost_fn": 1.0,
    "boost_coarse": 1.5,
    "boost_fine": 1.5,
    "boost_fp_svo": 1.5,
    "boost_fn_svo": 1.0,
    "boost_role_coarse": 1.0
  },
  "difficulty_levels": {
    "_comment": "Full data dès ep1 — pas de curriculum",
    "names": [
      "soft-full",
      "medium-full",
      "full"
    ],
    "hard_per_gold": [
      3,
      5,
      7
    ],
    "soft_factors": [
      1.0,
      1.0,
      1.0
    ],
    "max_epochs_per_level": 3,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },
  "early_stopping": {
    "patience": 999,
    "min_delta": 0.0
  },
  "hardware": {
    "h100_80gb": {
      "bs": 160,
      "accum": 1,
      "workers": 12
    },
    "l40s_48gb": {
      "bs": 128,
      "accum": 1,
      "workers": 12
    },
    "a100_40gb": {
      "bs": 96,
      "accum": 1,
      "workers": 10
    },
    "rtx_4090": {
      "bs": 80,
      "accum": 1,
      "workers": 10
    },
    "rtx_3090": {
      "bs": 64,
      "accum": 1,
      "workers": 4
    },
    "default": {
      "bs": 16,
      "accum": 2,
      "workers": 0
    }
  }
}

