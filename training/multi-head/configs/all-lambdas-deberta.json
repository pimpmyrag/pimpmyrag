{
  "_comment": "Relance du run v8.20-all-lambdas-1-deberta-bs80 — même config mais deberta-v3-base, 60 epochs",
  "_version": "all-lambdas-deberta",
  "_rationale": [
    "Copie exacte de all-lambdas-1.json mais avec microsoft/deberta-v3-base.",
    "Le run original (0527-1646) avait atteint fine_f1=0.849 en 8 epochs (coupé par pod).",
    "Pas de boundary_first, pas d'EMA — toutes lambdas actives dès ep1.",
    "lambda_compat=0 et lambda_verb_ptr=0 réduit la compétition sur boundary.",
    "60 epochs pour laisser fine_f1 continuer à monter (était encore en hausse à ep8)."
  ],

  "run": {
    "name_suffix": "all-lambdas-deberta",
    "max_epochs": 60,
    "model": "microsoft/deberta-v3-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },

  "optimizer": {
    "lr": 1e-5,
    "head_lr_multiplier": 6.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 1.0
  },

  "lambdas": {
    "_comment": "Toutes les lambdas à 1 — role_head ET role_coarse actifs simultanément.",
    "boundary":     2.5,
    "coarse":       0.5,
    "fine":         0.5,
    "svo_boundary": 0.5,
    "svo":          0.7,
    "role_coarse":  0.0,
    "role_oblique": 0.5,
    "role":         0.7,
    "voice":        0.3,
    "certainty":    0.3,
    "morpho":       0.3,
    "verb_ptr":     0.5,
    "compat":       0.5
  },

  "focal": {
    "boundary_gamma":  0.0,
    "fine_gamma":      0.0,
    "coarse_gamma":    0.0
  },

  "boundary_first": {
    "enabled": false,
    "unlock_threshold":    0.0,
    "unlock_ramp_epochs":  1,
    "coarse_warmup_lambda": 0.0,
    "fine_warmup_lambda":   0.0
  },

  "svo_cascade": {
    "_comment": "Aucune condition — tout actif dès ep1",
    "role_coarse_bnd_thr":       0.0,
    "role_coarse_warmup_lambda": 0.0,
    "role_ramp_epochs":          1,
    "role_thr_svo_bnd":          0.0,
    "phase2_ramp_epochs":        1,
    "oblique_thr_role_crs":      0.0,
    "oblique_ramp_epochs":       1
  },

  "boundary_rescue": {
    "window": 999, "target": 0.0, "min_delta": 0.0,
    "factor_vptr_voice": 1.0, "factor_coarse": 1.0, "bnd_boost": 1.0
  },

  "boundary_plateau": {
    "window": 999, "min_delta": 0.0,
    "regression_window": 999, "regression_delta": 0.0
  },

  "hard_negatives": {
    "every_n_epochs": 999,
    "decay":          1.0,
    "max_weight":     1.0,
    "min_weight":     1.0,
    "boost_fp":       1.0,
    "boost_fn":       1.0,
    "boost_coarse":   1.0,
    "boost_fine":     1.0,
    "boost_fp_svo":   1.0,
    "boost_fn_svo":   1.0,
    "boost_role_coarse": 1.0
  },

  "difficulty_levels": {
    "_comment": "Full data dès ep1 — pas de curriculum",
    "names":         ["full"],
    "hard_per_gold": [6],
    "soft_factors":  [1.0],
    "max_epochs_per_level":   999,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },

  "early_stopping": {
    "patience": 0,
    "min_delta": 0.0
  },

  "hardware": {
    "h100_80gb":  {"bs": 160, "accum": 1, "workers": 12},
    "l40s_48gb":  {"bs": 128, "accum": 1, "workers": 12},
    "a100_40gb":  {"bs":  96, "accum": 1, "workers": 10},
    "rtx_4090":   {"bs":  80, "accum": 1, "workers": 10},
    "rtx_3090":   {"bs":  64, "accum": 1, "workers": 4},
    "default":    {"bs":  16, "accum": 2, "workers": 0}
  }
}

