{
  "_comment": "RunPod v8.21 verbfam — basé sur le run local full concluant du 2026-06-03. Ajustement: boundary 1.5→2.5 + warmup NER léger. Role 12 labels conservé; role_coarse/role_oblique désactivés pour réduire le budget.",
  "_version": "runpod-v821-verbfam-balanced-r1",
  "_local_reference": {
    "config": "configs/local-cpu-v821-5pct-verb-ablation.json",
    "gold_version_used": "v8.21 -> train_v8.21_verbfam.jsonl full via auto-resolve",
    "epoch6_val": "score=0.8492 boundary=0.8740 coarse=0.8964 fine=0.7720 svo_bnd=0.8874 role=0.8458 verb_family=0.7534 verb_family_fine=0.3602",
    "runpod_adjustment": "boundary=2.5, boundary_first enabled threshold=0.87, coarse/fine warmup non agressif puis ramp 3 epochs, role_coarse=0, role_oblique=0 car role 12 labels suffit",
    "note": "Le nom 5pct de la config locale était trompeur: le train multitask courant a 27837 lignes."
  },

  "run": {
    "name_suffix": "runpod-v821-verbfam-balanced-r1",
    "max_epochs": 20,
    "model": "microsoft/deberta-v3-base",
    "loss_weighting": "fixed",
    "ner_only_bench": false
  },

  "optimizer": {
    "lr": 1e-5,
    "head_lr_multiplier": 4.0,
    "warmup_epochs": 0,
    "max_grad_norm": 1.0,
    "layer_lr_decay": 0.9,
    "ema_decay": 0.0,
    "class_weight_power": 0.25
  },

  "lambdas": {
    "boundary": 2.5,
    "coarse": 0.5,
    "fine": 1.5,
    "svo_boundary": 0.35,
    "svo": 0.7,
    "role": 0.7,
    "role_coarse": 0.0,
    "role_oblique": 0.0,
    "voice": 0.2,
    "certainty": 0.3,
    "morpho": 0.1,
    "verb_ptr": 0.6,
    "verb_family": 1.5,
    "verb_family_fine": 1.5,
    "verb_polarity": 1.0,
    "verb_aspect": 0.5,
    "verb_source": 0.3,
    "compat": 0.2
  },

  "focal": {
    "boundary_gamma": 0.5,
    "fine_gamma": 1.5,
    "coarse_gamma": 0.0
  },

  "boundary_first": {
    "enabled": true,
    "unlock_threshold": 0.87,
    "unlock_ramp_epochs": 3,
    "coarse_warmup_lambda": 0.25,
    "fine_warmup_lambda": 0.9
  },

  "svo_cascade": {
    "role_coarse_bnd_thr": 0.0,
    "role_coarse_warmup_lambda": 0.0,
    "role_ramp_epochs": 1,
    "role_thr_svo_bnd": 0.0,
    "phase2_ramp_epochs": 1,
    "oblique_thr_role_crs": 0.0,
    "oblique_ramp_epochs": 1
  },

  "boundary_rescue": {
    "window": 999,
    "target": 0.0,
    "min_delta": 0.0,
    "factor_vptr_voice": 1.0,
    "factor_coarse": 1.0,
    "bnd_boost": 1.0
  },

  "boundary_plateau": {
    "window": 999,
    "min_delta": 0.0,
    "regression_window": 999,
    "regression_delta": 0.0
  },

  "hard_negatives": {
    "every_n_epochs": 999,
    "decay": 1.0,
    "max_weight": 1.0,
    "min_weight": 1.0,
    "boost_fp": 1.0,
    "boost_fn": 1.0,
    "boost_coarse": 1.0,
    "boost_fine": 1.0,
    "boost_fp_svo": 1.0,
    "boost_fn_svo": 1.0,
    "boost_role_coarse": 1.0
  },

  "difficulty_levels": {
    "names": ["full"],
    "hard_per_gold": [6],
    "soft_factors": [1.0],
    "max_epochs_per_level": 999,
    "min_delta_for_progress": 0.0,
    "patience": 999
  },

  "early_stopping": {
    "patience": 0,
    "min_delta": 0.0
  },

  "hardware": {
    "h100_80gb": {"bs": 160, "accum": 1, "workers": 8},
    "l40s_48gb": {"bs": 128, "accum": 1, "workers": 6},
    "a100_40gb": {"bs": 96, "accum": 1, "workers": 6},
    "rtx_4090": {"bs": 80, "accum": 1, "workers": 8},
    "rtx_3090": {"bs": 64, "accum": 1, "workers": 4},
    "default": {"bs": 16, "accum": 2, "workers": 0}
